# ==============================================================================
# STUDENT FEEDBACK MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to '.env' and fill in your actual credentials.
# Never commit your real '.env' file to Git or share it publicly!
# ==============================================================================

# Port number for the Express backend server
PORT=3000

# Node environment mode: 'development' or 'production'
NODE_ENV=development

# Supabase Project URL (find this in Supabase Project Settings -> API -> Project URL)
# Example: https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase API Key (find this in Project Settings -> API -> Project API keys)
# Note: Use your project's 'anon public' key or 'service_role secret' key on the backend.
SUPABASE_KEY=your-supabase-api-key-here

# Secret key used to sign and verify JSON Web Tokens (JWT) for authentication
# Generate a secure string using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super_secret_jwt_key_for_btech_student_feedback_system_2024
